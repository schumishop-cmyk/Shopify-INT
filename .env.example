# Shopify API Credentials
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server Configuration
PORT=3000
NODE_ENV=development

# Carrier Service HMAC Secret (set this after registering the carrier service)
# Shopify signs carrier service requests - use any strong secret here
CARRIER_SERVICE_SECRET=your-strong-secret-here

# Public URL of this server (needed for Shopify to reach the carrier endpoint)
# For local dev use ngrok: https://abc123.ngrok-free.app
PUBLIC_URL=https://your-server.example.com
