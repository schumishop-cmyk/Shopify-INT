# Shopify API Credentials
# Die technische .myshopify.com-Adresse (Admin → Einstellungen → Domains),
# NICHT die Custom-Domain (lokalsportfan.de)
SHOPIFY_SHOP_DOMAIN=2c99af-3.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_KEY=9193536353d7d304a0c2414989304fb1
SHOPIFY_API_SECRET=<aus dem Partner Dashboard → Einstellungen → API Secret Key>

# Server Configuration
PORT=3000
NODE_ENV=development

# Carrier Service URL-Token: wird bei der Registrierung in die callback_url
# eingebettet (?token=...) und bei jedem Carrier-Request geprüft.
# Shopify signiert Carrier-Callbacks NICHT — ohne dieses Token wäre der
# Endpunkt öffentlich. 32+ zufällige Zeichen, z.B.: openssl rand -hex 32
# Achtung: nach Änderung muss der Carrier Service neu registriert werden.
CARRIER_SERVICE_SECRET=your-strong-secret-here

# Public URL of this server (needed for Shopify to reach the carrier endpoint)
# For local dev use ngrok: https://abc123.ngrok-free.app
PUBLIC_URL=https://shopify-int-production.up.railway.app
