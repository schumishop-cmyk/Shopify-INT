{
  "_comment": "Default shipping rules for US-based shops — priority: lower number is evaluated first. Weights are stored in grams (Shopify's internal unit) but chosen at pound boundaries: 2268g = 5 lb, 9072g = 20 lb.",
  "currency": "USD",
  "weightUnit": "lb",
  "rules": [
    {
      "id": "free-us-threshold",
      "name": "Free shipping US (orders over $50)",
      "priority": 10,
      "enabled": true,
      "conditions": {
        "destinationCountries": ["US"],
        "minCartPrice": 5000
      },
      "rates": [
        {
          "serviceName": "Free Shipping",
          "serviceCode": "free-standard-us",
          "price": 0,
          "description": "3–5 business days",
          "minDeliveryDays": 3,
          "maxDeliveryDays": 5
        }
      ]
    },
    {
